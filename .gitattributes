# adytum: секреты шифруются sops+age при записи в git.
# Scope — только директории хранилища; код и доки репозитория фильтры не трогают.
personal/** filter=adytum diff=adytum
nova/** filter=adytum diff=adytum
comuki/** filter=adytum diff=adytum
anlytra/** filter=adytum diff=adytum
vironima/** filter=adytum diff=adytum
keys/** filter=adytum diff=adytum
assistant/** filter=adytum diff=adytum
ssh/** filter=adytum diff=adytum
tokens/** filter=adytum diff=adytum

# Служебные файлы репозитория не шифруются.
.sops.yaml -filter -diff
.gitattributes -filter -diff
.gitignore -filter -diff
README.md -filter -diff
go.mod -filter -diff
go.sum -filter -diff
# пустые файлы шифровать нечего
comuki/openapi.json -filter -diff
comuki/projects.json -filter -diff